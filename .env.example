# =============================================================================
# BPS RAG Chatbot — Environment Variables Template
# =============================================================================
# Copy file ini menjadi `.env` lalu isi nilainya. Jangan commit file `.env`.
# .env asli sudah otomatis di-ignore oleh git (lihat .gitignore).
#
# Sebagian besar credentials disimpan di:
#   - program1_pdf_processor/.credentials_all.json (untuk backend & dashboard)
#   - n8n credentials (untuk workflow, set lewat UI n8n)
#
# File .env ini hanya untuk frontend (Vite) dan opsi build.
# =============================================================================

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Supabase URL untuk koneksi frontend ke database
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable / anon key (BUKAN service key — anon untuk client)
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Backend (program1_pdf_processor/api.py) ──────────────────────────────────
# Backend membaca credentials dari .credentials_all.json, bukan dari .env.
# Lihat docs/SETUP.md bagian "Konfigurasi Credentials" untuk detailnya.

# ── n8n ──────────────────────────────────────────────────────────────────────
# n8n credentials di-set lewat UI (Settings → Credentials), bukan .env.
# Lihat docs/N8N_GUIDE.md.
