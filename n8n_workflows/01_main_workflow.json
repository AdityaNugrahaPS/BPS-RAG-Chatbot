s.length > 0 && Array.isArray(results[keys[0]])) {\n    docs = results[keys[0]];\n  }\n}\n\n// Also try getting all items from the node\nif (docs.length === 0) {\n  try {\n    const allItems = $('Supabase Vector Search').all();\n    if (allItems.length > 0 && allItems[0].json.content) {\n      docs = allItems.map(item => item.json);\n    }\n  } catch(e) {}\n}\n\nif (docs.length === 0) {\n  return [{ json: { response: 'Tidak ada dokumen relevan ditemukan.' } }];\n}\n\nconst output = docs.map((r, i) => {\n  const src = (r.metadata && r.metadata.fileName) ? r.metadata.fileName : 'Dokumen BPS';\n  return '[' + (i+1) + '] ' + src + '\\n' + (r.content || '');\n}).join('\\n\\n---\\n\\n');\n\nreturn [{ json: { response: output } }];"},"id":"599398cc-13f3-471f-aade-dd5b12eafec5","name":"Format RAG Response","type":"n8n-nodes-base.code","typeVersion":2,"position":[5472,4976]},{"parameters":{"options":{},"model":"llama-3.3-70b-versatile"},"type":"@n8n/n8n-nodes-langchain.lmChatGroq","typeVersion":1,"position":[4880,4688],"id":"c5f0704b-f9b0-4115-88c1-ec6c4c6856ca","name":"Groq Chat Model","credentials":{"groqApi":{"id":"018Gtrip2tOz3vWU","name":"Groq account"}}},{"parameters":{"method":"POST","url":"http://host.docker.internal:54321/rest/v1/user_contacts","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"__SUPABASE_ANON_KEY__"},{"name":"Authorization","value":"Bearer __SUPABASE_ANON_KEY__"},{"name":"Content-Type","value":"application/json"},{"name":"Prefer","value":"resolution=merge-duplicates"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ session_id: $('Set Fields').item.json.sender, phone_number: $('Set Fields').item.json.sender.replace('@s.whatsapp.net','').replace('@c.us',''), last_seen: new Date().toISOString() }) }}","options":{"response":{"response":{"responseFormat":"json"}},"timeout":5000}},"id":"upsert-user-contact-001","name":"Upsert User Contact","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position"